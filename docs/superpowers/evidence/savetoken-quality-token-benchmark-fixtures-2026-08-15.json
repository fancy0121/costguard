{
  "date": "2026-08-15",
  "status": "frozen-design",
  "protocol": "run each task twice: Sol baseline (gpt-5.6-sol, default effort) then the execution-tier model below; identical input and acceptance",
  "tasks": [
    {
      "id": "EXT-01",
      "category": "extraction",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "华为于 2024 年在深圳发布了 Mate 60 系列，任正非表示将持续投入基础研究。请提取文中出现的所有组织名与人物名。",
      "acceptance": { "type": "exact_set", "expected": ["华为", "任正非"] }
    },
    {
      "id": "CLS-02",
      "category": "classification",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "将以下标题逐条分类到 {科技,财经,体育,娱乐}：1) 央行下调存款准备金率 2) 新款折叠屏手机发布 3) 国足晋级亚洲杯四强 4) 某演员官宣婚讯 5) 美股三大指数收涨 6) 人工智能芯片出口新政 7) 马拉松选手刷新纪录 8) 票房破十亿。只输出 8 个标签的列表。",
      "acceptance": { "type": "exact_list", "expected": ["财经", "科技", "体育", "娱乐", "财经", "科技", "体育", "娱乐"] }
    },
    {
      "id": "FMT-03",
      "category": "transform",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "把下面的 Markdown 表格转成 JSON 数组（对象键为 name,price,stock）：\n| name | price | stock |\n| --- | --- | --- |\n| apple | 3.5 | 20 |\n| banana | 2.0 | 0 |",
      "acceptance": { "type": "exact_json", "expected": [{ "name": "apple", "price": 3.5, "stock": 20 }, { "name": "banana", "price": 2.0, "stock": 0 }] }
    },
    {
      "id": "SUM-04",
      "category": "summarization",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "请用不超过 30 个汉字概括：2026 年 8 月，国产大飞机 C919 首次执飞上海到广州的商业航线，共搭载 158 名乘客，标志着国产干线客机正式进入规模化运营阶段。",
      "acceptance": { "type": "contains_and_bound", "mustContain": ["C919", "商业航线"], "maxChars": 30 }
    },
    {
      "id": "SCH-05",
      "category": "strict-json-object",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "返回一个 JSON 对象，只含键 name（字符串）、count（整数）、active（布尔）。不要任何额外键。",
      "acceptance": { "type": "exact_json", "expected": { "name": "alpha", "count": 7, "active": true }, "tolerateOnly": ["name", "count", "active"], "expectedMayFail": true }
    },
    {
      "id": "SCH-06",
      "category": "strict-json-schema",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "返回一个描述书籍的 JSON 对象，只含 title（字符串）和 pages（整数）两个键。",
      "acceptance": { "type": "strict_schema", "properties": ["title", "pages"], "additionalProperties": false, "expectedMayFail": true }
    },
    {
      "id": "TOOL-07",
      "category": "tool-single",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "查询北京的天气。",
      "tools": [{ "type": "function", "name": "get_weather", "parameters": { "type": "object", "properties": { "city": { "type": "string" } }, "required": ["city"] } }],
      "acceptance": { "type": "function_call", "name": "get_weather", "argsContain": { "city": "北京" } }
    },
    {
      "id": "TOOL-08",
      "category": "tool-multi-turn",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "查询巴黎的天气，并告诉我是否适合出门。",
      "tools": [{ "type": "function", "name": "get_weather", "parameters": { "type": "object", "properties": { "city": { "type": "string" } }, "required": ["city"] } }],
      "acceptance": { "type": "final_answer_uses_tool", "toolResult": { "temperature_c": 20, "condition": "sunny" }, "mustContain": ["sunny"] }
    },
    {
      "id": "CODE-09",
      "category": "code-simple",
      "expectedTier": "execution",
      "expectedModel": "openai/gpt-5.6-luna",
      "input": "用 TypeScript 实现函数 isPalindrome(s: string): boolean，忽略大小写与非字母数字字符。",
      "acceptance": { "type": "local_tests", "cases": [["A man, a plan, a canal: Panama", true], ["race a car", false], ["", true], ["0P", false]] }
    },
    {
      "id": "CODE-10",
      "category": "code-bug",
      "expectedTier": "terra",
      "expectedModel": "openai/gpt-5.6-terra",
      "input": "以下函数计算数组最大值，但有缺陷：\nfunction max(a: number[]): number { let m = 0; for (const x of a) { if (x > m) m = x; } return m; }\n请指出缺陷行与根因。",
      "acceptance": { "type": "identify_bug", "mustContain": ["m = 0", "负数", "初始化"] }
    },
    {
      "id": "TEST-11",
      "category": "test-design",
      "expectedTier": "execution",
      "expectedModel": "openai/gpt-5.6-luna",
      "input": "为 isPalindrome 设计测试用例，覆盖：回文、非回文、空串、忽略标点、忽略大小写。",
      "acceptance": { "type": "required_cases", "required": ["回文", "非回文", "空串", "标点", "大小写"] }
    },
    {
      "id": "TRA-12",
      "category": "translation",
      "expectedTier": "execution",
      "expectedModel": "deepseek/deepseek-v4-flash",
      "input": "Translate to Chinese: The central bank cut the reserve requirement ratio to support lending.",
      "acceptance": { "type": "contains_and_no_english", "mustContain": ["央行", "存款准备金"], "noAsciiLetters": true }
    }
  ]
}
